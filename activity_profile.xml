<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Title -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#8A004F"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_profile1"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Profile Picture -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="vertical"
            android:background="@drawable/profilegradient"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/profile_image"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:clipToOutline="true"
                android:contentDescription="@string/profpic"
                android:padding="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/profile"
                tools:ignore="ContentDescription,ImageContrastCheck"
                tools:targetApi="31" />

            <TextView
                android:id="@+id/txt_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/fatimah"
                android:textColor="#FFEBEE"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText,TextContrastCheck" />
        </LinearLayout>

        <!-- Profile Details -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/email"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/txt_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/example_email_com"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btn_change_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/change_email1"
                android:backgroundTint="#8A004F"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <!-- Mobile Number -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mobile_number1"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/txt_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/_60_123_456_7891"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_change_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/change_mobile_number1"
                android:backgroundTint="#8A004F"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>

            <!-- Date of Birth -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/date_of_birth"
                android:textStyle="bold"
                android:textColor="#333333"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/txt_dob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/_01_01_1990"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"/>

            <!-- Gender -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gender"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/txt_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/femalefemale"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"/>

            <!-- Race -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/racerace"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/txt_race"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/malayq"
                android:padding="12dp"
                android:background="#FFFFFF"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- View Order History Button -->
            <Button
                android:id="@+id/btn_view_orders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#8A004F"
                android:text="@string/view_order_history"
                android:textColor="#FFFFFF"
                tools:ignore="TouchTargetSizeCheck" />

            <!-- Logout Button -->
            <Button
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/logoutlogout"
                android:backgroundTint="#8A004F"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
